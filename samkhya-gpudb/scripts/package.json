{
  "name": "samkhya-llm-server",
  "version": "1.1.0",
  "private": true,
  "description": "TypeScript port of the samkhya LLM-pluggable corrector inference server. Mirrors the wire contract of llm_infer_server.py.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/llm_infer_server.js",
    "start:dummy": "node dist/llm_dummy_backend.js",
    "dev": "tsx llm_infer_server.ts",
    "dev:dummy": "tsx llm_dummy_backend.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:wire": "npm run build && node wire_contract_test.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "openai": "^4.60.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": { "optional": true },
    "openai": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
